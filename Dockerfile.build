# Dockerfile for building SoftEther OpenWrt packages
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    flex \
    bison \
    g++ \
    gawk \
    gcc-multilib \
    g++-multilib \
    gettext \
    git \
    libncurses-dev \
    libssl-dev \
    python3-distutils \
    rsync \
    unzip \
    zlib1g-dev \
    file \
    wget \
    curl \
    subversion \
    swig \
    time \
    xsltproc \
    && rm -rf /var/lib/apt/lists/*

# Add non-root build user
RUN useradd -m -s /bin/bash builder
USER builder
WORKDIR /home/builder

CMD ["/bin/bash"]
