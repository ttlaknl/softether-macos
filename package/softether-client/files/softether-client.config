config global 'general'
	option enabled '0'
	option vnic_name 'vpn0'
	option watchdog '1'
	option watchdog_interval '30'
	option ping_host '8.8.8.8'
	option log_level '2'

config account 'main'
	option account_name 'default'
	option server_host 'vpn.example.com'
	option server_port '443'
	option hub 'DEFAULT'
	option auth_type 'standard'
	option username 'user'
	option password 'password'
	option max_connections '8'
	option encrypt '1'
	option compress '0'
	option half_duplex '0'
	option auto_reconnect '1'
	option reconnect_interval '10'
	option reconnect_count '0'

config routing 'routing'
	option mode 'bypass_china'
	option auto_update_chnroute 'weekly'
	option nat '1'
	option dns_mode 'vpn'
	option default_metric '50'
	list subnet '10.0.0.0/8'
	list subnet '172.16.0.0/12'
	list subnet '192.168.0.0/16'
